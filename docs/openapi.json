            "minLength": 3,
            "title": "Bundle Id",
            "type": "string"
          },
          "features": {
            "items": {
              "type": "string"
            },
            "maxItems": 100,
            "title": "Features",
            "type": "array"
          },
          "name": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "product_id": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9._-]+$",
            "title": "Product Id",
            "type": "string"
          },
          "rights_reference": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rights Reference"
          },
          "status": {
            "default": "blocked",
            "enum": [
              "blocked",
              "available"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "name",
          "bundle_id",
          "version"
        ],
        "title": "AdminProduct",
        "type": "object"
      },
      "AdminUser": {
        "additionalProperties": false,
        "properties": {
          "account_identifier": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Account Identifier",
            "type": "string"
          }
        },
        "required": [
          "account_identifier"
        ],
        "title": "AdminUser",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
