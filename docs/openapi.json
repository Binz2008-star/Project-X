{
  "components": {
    "schemas": {
      "Activate": {
        "additionalProperties": false,
        "properties": {
          "activation_code": {
            "maxLength": 256,
            "minLength": 16,
            "title": "Activation Code",
            "type": "string"
          },
          "product_id": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Product Id",
            "type": "string"
          }
        },
        "required": [
          "product_id",
          "activation_code"
        ],
        "title": "Activate",
        "type": "object"
      },
      "AdminExtend": {
        "additionalProperties": false,
